# Salin file ini menjadi `.env` lalu sesuaikan nilainya:
#   cp .env.example .env
# File `.env` JANGAN di-commit (sudah ada di .gitignore).

# Nama aplikasi yang tampil di task switcher / title
APP_NAME=Catatan Keuangan

# Tampilkan Device Preview (simulasi berbagai ukuran perangkat).
# Hanya aktif pada mode debug/profile; di release otomatis nonaktif.
ENABLE_DEVICE_PREVIEW=true

# Pakai Firebase Emulator Suite untuk pengembangan lokal (tanpa menyentuh data asli).
# Jalankan dulu: firebase emulators:start --only auth,firestore
USE_FIREBASE_EMULATOR=false

# Host emulator:
#   Android emulator -> 10.0.2.2
#   iOS simulator / desktop / web -> localhost
#   HP fisik -> IP komputermu di jaringan yang sama
FIREBASE_EMULATOR_HOST=10.0.2.2
FIRESTORE_EMULATOR_PORT=8080
AUTH_EMULATOR_PORT=9099

# Catatan: konfigurasi Firebase (apiKey, appId, dll.) tetap berasal dari
# lib/firebase_options.dart hasil `flutterfire configure`.
