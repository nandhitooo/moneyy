rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Setiap user hanya boleh mengakses transaksinya sendiri
    match /users/{userId}/transactions/{txId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Daftar sumber dana milik user (tunai, rekening bank, e-wallet)
    match /users/{userId}/sources/{sourceId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Penanda migrasi data milik user (mis. pengisian field signedAmount)
    match /users/{userId}/meta/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
